<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for page in site.html_pages %}{% unless page.url == "/404.html" %}
  <url><loc>{{ page.url | absolute_url }}</loc></url>
{%- endunless %}{% endfor %}
{%- for item in site.projects %}
  <url><loc>{{ item.url | absolute_url }}</loc></url>
{%- endfor %}
{%- for item in site.artworks %}
  <url><loc>{{ item.url | absolute_url }}</loc></url>
{%- endfor %}
</urlset>
